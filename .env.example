DISCORD_TOKEN=your_discord_bot_token
TAVILY_API_KEY=your_tavily_api_key

# Optional: DEBUG | INFO | WARNING | ERROR (mặc định INFO)
# LOG_LEVEL=INFO

# Welcome message khi thành viên mới vào server. Khi bật, cần bật thêm
# Server Members Intent trong Discord Developer Portal > Bot.
# WELCOME_ENABLED=false
# WELCOME_CHANNEL_ID=
# WELCOME_RULES_CHANNEL_ID=
# WELCOME_ROLES_CHANNEL_ID=
# WELCOME_INCLUDE_BOTS=false
# WELCOME_TITLE=Chào mừng bạn đến với Peto's Server!
# Mặc định dùng GIF bền vững đã lưu trong repo. URL, nếu có, sẽ được ưu tiên.
# WELCOME_GIF_FILE=assets/welcome_teto.gif
# WELCOME_GIF_URL=

# Optional: đường dẫn FFmpeg nếu lệnh `ffmpeg` chưa có trong PATH
# FFMPEG_BINARY=C:\ffmpeg\bin\ffmpeg.exe

# Optional: file SQLite lưu favorites, playlists và lịch sử nghe
# MUSIC_LIBRARY_DB=music_library.db

# Download Gateway cho file vượt giới hạn Discord. Chỉ bỏ comment sau khi
# Cloudflare Tunnel đã trỏ hostname này tới http://127.0.0.1:8765.
# DOWNLOAD_PUBLIC_BASE_URL=https://download.pearto.shop
# DOWNLOAD_GATEWAY_HOST=127.0.0.1
# DOWNLOAD_GATEWAY_PORT=8765
# DOWNLOAD_FILE_TTL_SECONDS=7200
# DOWNLOAD_MAX_FILE_MIB=512
# DOWNLOAD_MAX_TOTAL_MIB=2048

# Kho kiến thức Limbus Company Wiki (không cần API key).
# LIMBUS_WIKI_SYNC_HOURS=12
# LIMBUS_WIKI_SYNC_CONCURRENCY=2
# LIMBUS_WIKI_REQUEST_DELAY=0.20
# LIMBUS_WIKI_DB=limbus_knowledge.db
# Kích thước thumbnail Identity/E.G.O lấy từ wiki CDN (256-1200 px).
# LIMBUS_ASSET_THUMB_SIZE=700
# Nên đặt một chuỗi User-Agent nhận diện riêng nếu bot được phát hành công khai.
# LIMBUS_WIKI_USER_AGENT=PetoDiscordBot/1.0 (personal Discord knowledge assistant)
# LIMBUS_NEWS_ANSWER_CACHE_MINUTES=60

# Standard Extraction Limbus bằng roster/artwork trong database wiki.
# Economy mặc định tắt theo từng server: /gacha vẫn là mô phỏng miễn phí.
# Khi quản trị viên dùng /economy enable, quay x1/x10 (hoặc FGO x11) tốn
# 130/1300 Peto Points,
# sinh Extraction Points và lưu collection. Không dùng Lunacy thật.
# LIMBUS_GACHA_ENABLED=true
# LIMBUS_GACHA_POOL_REFRESH_SECONDS=900
# LIMBUS_GACHA_VIEW_TIMEOUT_SECONDS=180
# LIMBUS_GACHA_IMAGE_MAX_MIB=8
# LIMBUS_GACHA_IMAGE_TIMEOUT_SECONDS=45
# LIMBUS_GACHA_ART_CACHE_DIR=limbus_gacha_art_cache

# Blue Archive dùng chung /gacha và Peto Economy. Banner/pool lấy từ SchaleDB.
# BLUE_ARCHIVE_GACHA_ART_CACHE_DIR=blue_archive_gacha_art_cache

# Fate/Grand Order dùng chung /gacha và Peto Economy. Metadata/ảnh lấy từ
# Atlas Academy rồi được cache theo nhu cầu; không cần tải toàn bộ ảnh vào repo.
# FGO_GACHA_ART_CACHE_DIR=fgo_gacha_art_cache
# FGO_GACHA_DATA_CACHE_DIR=fgo_gacha_data_cache

# Brown Dust 2 dùng chung /gacha và Peto Economy. Costume drawable, không
# limited được đồng bộ qua Cargo API của Brown Dust 2 Wiki rồi cache cục bộ.
# BD2_GACHA_ART_CACHE_DIR=bd2_gacha_art_cache
# BD2_GACHA_DATA_CACHE_DIR=bd2_gacha_data_cache

# Peto Economy. Cấu hình bật/tắt và kênh leaderboard/event nằm riêng trong từng
# server qua /economy; các giá trị điểm bên dưới là mức gốc trước hệ số.
# PETO_ECONOMY_DB=peto_economy.db
# PETO_ECONOMY_CHAT_MIN_POINTS=8
# PETO_ECONOMY_CHAT_MAX_POINTS=12
# PETO_ECONOMY_CHAT_COOLDOWN_SECONDS=60
# PETO_ECONOMY_VOICE_POINTS=5
# PETO_ECONOMY_VOICE_INTERVAL_SECONDS=300
# PETO_ECONOMY_DAILY_CAP=500
# Ngày thường ×2; Thứ Bảy và Chủ Nhật (UTC+7) ×5. Hệ số áp dụng cho cả
# điểm chat, điểm voice và giới hạn ngày.
# PETO_ECONOMY_NORMAL_MULTIPLIER=2
# PETO_ECONOMY_WEEKEND_MULTIPLIER=5

# Theo dõi video Limbus mới từ YouTube chính thức của Project Moon.
# Lần chạy đầu chỉ tạo mốc, không gửi lại các video cũ.
# PROJECT_MOON_YOUTUBE_ENABLED=false
# PROJECT_MOON_YOUTUBE_DISCORD_CHANNEL_ID=
# Optional: role được ping khi có video mới.
# PROJECT_MOON_YOUTUBE_MENTION_ROLE_ID=
# PROJECT_MOON_YOUTUBE_POLL_MINUTES=10
# Mặc định chỉ nhận video có LimbusCompany/Limbus Company trong tiêu đề hoặc mô tả.
# Để trống giá trị này nếu muốn nhận mọi video Project Moon.
# PROJECT_MOON_YOUTUBE_KEYWORDS=LimbusCompany,Limbus Company
# Thường không cần đổi hai giá trị bên dưới.
# PROJECT_MOON_YOUTUBE_CHANNEL_ID=UCpqyr6h4RCXCEswHlkSjykA
# PROJECT_MOON_YOUTUBE_DB=youtube_notifications.db

# Cấu hình channel/role riêng cho từng Discord server bằng /settings notifications.
# Các *_CHANNEL_ID và *_ROLE_ID bên dưới vẫn là fallback cho server cũ.
# GUILD_SETTINGS_DB=guild_settings.db

# Daily Reset đa game. Giờ mặc định dùng UTC và có thể đổi riêng từng game.
# Có thể bật thử một game trước, ví dụ DAILY_RESET_GAMES=nikke
# DAILY_RESET_ENABLED=false
# Một game: limbus_company; nhiều game: limbus_company,nikke,brown_dust_2
# Tất cả game: all
# DAILY_RESET_GAMES=all
# DAILY_RESET_WARNING_MINUTES=60
# Khi bot restart ngay sau giờ gửi, cho phép gửi bù tối đa N phút.
# DAILY_RESET_CATCHUP_MINUTES=5
# DAILY_RESET_DB=daily_reset_notifications.db

# DAILY_RESET_NIKKE_CHANNEL_ID=
# DAILY_RESET_NIKKE_ROLE_ID=
# DAILY_RESET_NIKKE_TIME=20:00
# DAILY_RESET_NIKKE_IMAGE_URL=

# DAILY_RESET_BLUE_ARCHIVE_CHANNEL_ID=
# DAILY_RESET_BLUE_ARCHIVE_ROLE_ID=
# DAILY_RESET_BLUE_ARCHIVE_TIME=19:00
# DAILY_RESET_BLUE_ARCHIVE_IMAGE_URL=

# DAILY_RESET_TRICKCAL_CHANNEL_ID=
# DAILY_RESET_TRICKCAL_ROLE_ID=
# DAILY_RESET_TRICKCAL_TIME=19:00
# DAILY_RESET_TRICKCAL_IMAGE_URL=

# DAILY_RESET_CHAOS_ZERO_NIGHTMARE_CHANNEL_ID=
# DAILY_RESET_CHAOS_ZERO_NIGHTMARE_ROLE_ID=
# DAILY_RESET_CHAOS_ZERO_NIGHTMARE_TIME=18:00
# DAILY_RESET_CHAOS_ZERO_NIGHTMARE_IMAGE_URL=

# Limbus chỉ nhắc Mirror Dungeon vào Thứ Năm hằng tuần lúc 06:00 KST,
# tương ứng 21:00 UTC Thứ Tư. TIME vẫn được cấu hình theo UTC.
# DAILY_RESET_LIMBUS_COMPANY_CHANNEL_ID=
# DAILY_RESET_LIMBUS_COMPANY_ROLE_ID=
# DAILY_RESET_LIMBUS_COMPANY_TIME=21:00
# DAILY_RESET_LIMBUS_COMPANY_IMAGE_URL=

# DAILY_RESET_BROWN_DUST_2_CHANNEL_ID=
# DAILY_RESET_BROWN_DUST_2_ROLE_ID=
# DAILY_RESET_BROWN_DUST_2_TIME=00:00
# DAILY_RESET_BROWN_DUST_2_IMAGE_URL=

# Gift code/coupon. Code được chủ bot thêm bằng /coupon add; thành viên có thể
# đăng ký DM hoặc tự nguyện lưu nickname BD2 để bật auto-redeem.
# COUPON_DB=coupon_codes.db
# COUPON_WARNING_DAYS=3
# Endpoint bên thứ ba dùng bởi rapi-bot; không cần đổi nếu BD2 Pulse vẫn hoạt động.
# COUPON_BD2_REDEEM_URL=https://api.thebd2pulse.com/redeem/coupon
# COUPON_BD2_RATE_LIMIT_SECONDS=2.5
# Mỗi game có thể có kênh thông báo và role ping riêng; để trống = chỉ dùng DM.
# COUPON_BROWN_DUST_2_CHANNEL_ID=
# COUPON_BROWN_DUST_2_ROLE_ID=
# COUPON_NIKKE_CHANNEL_ID=
# COUPON_NIKKE_ROLE_ID=
# COUPON_BLUE_ARCHIVE_CHANNEL_ID=
# COUPON_BLUE_ARCHIVE_ROLE_ID=

# Optional: font TrueType tùy chỉnh khi Study Mode xuất lời giải PNG
# STUDY_FONT_PATH=C:\Windows\Fonts\arial.ttf

# Model Grok qua SuperGrok OAuth (không cần API key trả tiền).
# Login 1 lần: python -m xai_oauth login
XAI_MODEL=grok-4.6

# Optional: đường dẫn file token OAuth (mặc định: .xai_tokens.json)
# XAI_TOKEN_PATH=.xai_tokens.json

# Optional: base URL xAI (mặc định https://api.x.ai/v1)
# XAI_BASE_URL=https://api.x.ai/v1

# Giới hạn một request Grok để tránh giữ người dùng chờ nhiều phút khi xAI treo.
# Low sẽ tự thử lại 1 lần; medium/high không nhân đôi thời gian chờ.
# XAI_TIMEOUT_LOW_SECONDS=45
# XAI_TIMEOUT_MEDIUM_SECONDS=180
# XAI_TIMEOUT_HIGH_SECONDS=240

# Optional fallback pay-as-you-go nếu OAuth 403 / không dùng SuperGrok
# XAI_API_KEY=

# Tài khoản X chính thức được ưu tiên cho tin Limbus thời sự (cách nhau bởi dấu phẩy)
# LIMBUS_OFFICIAL_X_HANDLES=LimbusCompany_B

# Vision (xem ảnh Discord): detail auto|low|high, tối đa N ảnh/tin
# XAI_IMAGE_DETAIL=auto
# XAI_MAX_IMAGES=4

# Đọc video Discord ngắn: trích frame bằng FFmpeg và phiên âm qua xAI STT.
# Chỉ kích hoạt khi người dùng hỏi về video; không tự đọc mọi clip trong kênh.
# XAI_VIDEO_MAX_MIB=50
# XAI_VIDEO_MAX_SECONDS=120
# XAI_VIDEO_FRAMES=8
# XAI_STT_URL=https://api.x.ai/v1/stt

# Giới hạn trần do chủ bot kiểm soát cho /settings ai. Quản trị viên từng
# server chỉ có thể chọn giá trị bằng hoặc thấp hơn các mức này.
# AI_SETTINGS_DEFAULT_COOLDOWN_SECONDS=5
# AI_SETTINGS_DEFAULT_HEAVY_COOLDOWN_SECONDS=30
# AI_SETTINGS_DEFAULT_MAX_CONCURRENT=3
# AI_SETTINGS_MAX_CONCURRENT=5
# AI_SETTINGS_DEFAULT_MAX_VIDEO_SECONDS=120
# AI_SETTINGS_MAX_QUEUE_PER_GUILD=6
# AI_SETTINGS_QUEUE_TIMEOUT_SECONDS=60

# AI tạo ảnh (Grok Imagine) — khác Danbooru; luôn 1 ảnh/lần
# XAI_IMAGE_GEN_MODEL=grok-imagine-image

# Custom Pixiv embed kiểu SaucyBot. Điền giá trị cookie PHPSESSID từ phiên
# đăng nhập Pixiv của chính bạn. Đây là secret: không chia sẻ hoặc commit.
# PIXIV_PHPSESSID=
# PIXIV_UGOIRA_MAX_SOURCE_MIB=256
# PIXIV_UGOIRA_FFMPEG_TIMEOUT_SECONDS=180

# YouTube trên VPS/datacenter: chỉ cho yt-dlp đi qua WARP local proxy.
# YTDLP_PROXY=socks5://127.0.0.1:40000
# YTDLP_JS_RUNTIME=node
# YTDLP_REMOTE_COMPONENTS=ejs:github
# Danh sách client dự phòng được thử lần lượt khi metadata/tải audio lỗi;
# mặc định web_embedded,mweb khi có BgUtils.
# YTDLP_YOUTUBE_CLIENT=web_embedded,mweb
# Optional: BgUtils POT server. Dùng IPv6 loopback nếu curl 127.0.0.1:4416
# thất bại nhưng curl http://[::1]:4416/ping hoạt động.
# YTDLP_BGUTIL_URL=http://[::1]:4416
# YTDLP_COOKIE_FILE=cookies.txt
# Khi cả hai YouTube client vẫn gặp bot-check/403/429, tìm bản SoundCloud đủ
# khớp rồi stream trực tiếp. Fallback này không tạo cache hoặc file normalize.
# YTDLP_SOUNDCLOUD_FALLBACK=false
# Nếu SoundCloud không có bản phù hợp, có thể thử tiếp catalog Audius công khai.
# Audius cũng chỉ stream trực tiếp và không tạo audio cache.
# YTDLP_AUDIUS_FALLBACK=false
# Tổng thời gian tối đa cho cả chuỗi SoundCloud -> Audius.
# YTDLP_AUDIO_FALLBACK_TIMEOUT_SECONDS=20
# Tên cũ vẫn được hỗ trợ để VPS đang chạy không bị đổi cấu hình đột ngột.
# YTDLP_SOUNDCLOUD_FALLBACK_TIMEOUT_SECONDS=20
# Chỉ nhớ URL/track ID đã khớp trong RAM; không lưu stream CDN hoặc audio.
# YTDLP_SOUNDCLOUD_FALLBACK_TTL_SECONDS=1800
