DISCORD_TOKEN=your_discord_bot_token
GEMINI_API_KEY=your_google_ai_studio_api_key
TAVILY_API_KEY=your_tavily_api_key

# Có thể đổi model mà không cần sửa code.
GEMINI_MODEL=gemini-3.6-flash

# Mặc định cân bằng cho roleplay: chỉ chặn xác suất gây hại cao.
# Giá trị hợp lệ: BLOCK_ONLY_HIGH, BLOCK_MEDIUM_AND_ABOVE,
# BLOCK_LOW_AND_ABOVE, BLOCK_NONE hoặc OFF.
GEMINI_SAFETY_THRESHOLD=BLOCK_ONLY_HIGH
