DISCORD_TOKEN=your_discord_bot_token
TAVILY_API_KEY=your_tavily_api_key

# Model Grok qua SuperGrok OAuth (không cần API key trả tiền).
# Login 1 lần: python -m xai_oauth login
XAI_MODEL=grok-4.5

# Optional: đường dẫn file token OAuth (mặc định: .xai_tokens.json)
# XAI_TOKEN_PATH=.xai_tokens.json

# Optional: base URL xAI (mặc định https://api.x.ai/v1)
# XAI_BASE_URL=https://api.x.ai/v1

# Optional fallback pay-as-you-go nếu OAuth 403 / không dùng SuperGrok
# XAI_API_KEY=

# Vision (xem ảnh Discord): detail auto|low|high, tối đa N ảnh/tin
# XAI_IMAGE_DETAIL=auto
# XAI_MAX_IMAGES=4
